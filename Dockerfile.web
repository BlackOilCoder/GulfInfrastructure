FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp/bluewater-home \
    BLUEWATER_DATA_DIR=/data \
    BLUEWATER_BATHYMETRY_DIR=/bathymetry \
    BLUEWATER_STRUCTURES_FILE=/inputs/platform-structures.js \
    BLUEWATER_PROJ_DIR=/tmp/bluewater-proj \
    PORT=8080
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libexpat1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 bluewater \
    && useradd --uid 10001 --gid 10001 --no-create-home bluewater
COPY deploy/requirements-common.txt deploy/requirements-web.txt /app/deploy/
RUN pip install --no-cache-dir --only-binary=:all: -r deploy/requirements-web.txt
COPY app/ /app/app/
COPY tools/bathymetry.py tools/config.py tools/container_entrypoint.py tools/storage.py tools/cloud_bathymetry.py tools/projection.py tools/infrastructure.py /app/tools/
COPY index.html /app/index.html
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["python", "tools/container_entrypoint.py", "web"]
