# Run python tools/configure_containers.py to fill these from this checkout.
# Host paths use forward slashes, including on Windows; quote paths with spaces.
BLUEWATER_HOST_DATA=./data
BLUEWATER_HOST_STRUCTURES=./platform-structures.js
BLUEWATER_HOST_BATHYMETRY=/absolute/path/to/Bluewater/bathymetry
BLUEWATER_HTTP_PORT=8080
BLUEWATER_RASTER_CONCURRENCY=4
BLUEWATER_RELEASE=local
# Optional credentials for the currents worker only. Never commit .env.
BLUEWATER_COPERNICUS_USERNAME=
BLUEWATER_COPERNICUS_PASSWORD=
